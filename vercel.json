{
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/SiteHome(.*)", "destination": "/index.html" },
    { "source": "/SiteServices(.*)", "destination": "/services.html" },
    { "source": "/SitePackages(.*)", "destination": "/packages.html" },
    { "source": "/SiteProcess(.*)", "destination": "/process.html" },
    { "source": "/SiteTrust(.*)", "destination": "/trust.html" },
    { "source": "/SiteAbout(.*)", "destination": "/about.html" },
    { "source": "/SiteCareers(.*)", "destination": "/careers.html" },
    { "source": "/SiteContact(.*)", "destination": "/contact.html" },
    { "source": "/SiteCheck(.*)", "destination": "/check.html" },
    { "source": "/SiteERP(.*)", "destination": "/erp.html" },
    { "source": "/SiteLogin(.*)", "destination": "/login.html" },
    { "source": "/SiteStaffLogin(.*)", "destination": "/staff-login.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
